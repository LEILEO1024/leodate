{
  "name": "leodate",
  "version": "1.2.0",
  "description": "月度线索数据统计软件",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env ELECTRON_RUN_AS_NODE= vite",
    "build": "cross-env ELECTRON_RUN_AS_NODE= vue-tsc --noEmit && vite build && electron-builder",
    "build:win": "cross-env ELECTRON_RUN_AS_NODE= vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "pinia": "^2.3.0",
    "sql.js": "^1.12.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "cross-env": "^10.1.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vue-tsc": "^2.2.0"
  }
}
